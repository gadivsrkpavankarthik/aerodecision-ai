# ============================================================
# AERODECISION AI - ENVIRONMENT CONFIGURATION
# ============================================================

# Copy this file to .env and set values locally without committing secrets.
# AeroDecision AI: explainable flight decisions with independent verification.
# Ranking weights default to price .35 / departure .20 / duration .15 / stops .10 / verification .20.
# RANKING_AIRLINE_WEIGHT only applies when the user sets a preferred airline.
# Example placeholders only; do not commit real credentials.
IGNAV_API_KEY=replace_with_ignav_api_key
IGNAV_BASE_URL=https://ignav.com/api

AVIATIONSTACK_API_KEY=replace_with_aviationstack_api_key
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

NVIDIA_API_KEY=replace_with_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

RANKING_PRICE_WEIGHT=0.35
RANKING_AIRLINE_WEIGHT=0.0
RANKING_DEPARTURE_WEIGHT=0.20
RANKING_DURATION_WEIGHT=0.15
RANKING_STOPS_WEIGHT=0.10
RANKING_VERIFICATION_WEIGHT=0.20
DEFAULT_COMPARISON_CURRENCY=INR
ECB_FX_MAX_AGE_DAYS=4
